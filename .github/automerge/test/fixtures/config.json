{
	"base": "main",
	"author": "cameron-nye",
	"factoryPrefixes": ["habits/issue-", "factory/"],
	"reviewOnlyPrefixes": ["cursor/"],
	"timeoutMinutes": 60,
	"fixupStaleHours": 4,
	"fixupLabel": "factory-fixup-running",
	"noAutomergeLabel": "no-automerge",
	"deviceTestPattern": "device[- ]?(test|check)|real[- ](phone|device)|physical (phone|device)|on[- ]device (test|check)|airplane[- ]mode|manual(ly)? test(ed)? on (a )?(phone|device)",
	"ciWorkflow": "✅ Validate",
	"catalogPath": null,
	"manualPaths": [
		".github/workflows/**",
		"**/wrangler.jsonc",
		"**/wrangler.json",
		"**/wrangler.toml",
		"wrangler-env.ts",
		"packages/*/migrations/**",
		"packages/worker/audit-migrations/**",
		"**/*.sql",
		"packages/worker/src/billing/**",
		"packages/worker/src/authorization/**",
		"packages/worker/src/identity/**",
		"packages/worker/src/oauth-device/**",
		"packages/worker/src/oidc/**",
		"packages/worker/src/credentials/**",
		"packages/worker/src/secrets/**",
		"packages/worker/src/mcp/secrets/**",
		"packages/worker/src/mcp/capabilities/secrets/**",
		"packages/worker/src/execution-contexts/**",
		"packages/shared/src/execution-context-protocol/**",
		"packages/backup-control-plane/**",
		"**/.env",
		"**/.env.*",
		"**/.dev.vars*",
		"patches/**",
		"packages/shared/**",
		"packages/worker/src/api-tokens/**",
		"packages/worker/src/webhooks/**",
		"packages/worker/src/mcp/capabilities/webhooks/**",
		"packages/worker/src/security/**",
		"packages/worker/src/oauth-*",
		"packages/worker/src/mcp-auth*",
		"packages/worker/src/app/handlers/auth.ts",
		"packages/worker/src/app/handlers/auth-provider.ts",
		"packages/worker/src/app/handlers/stripe-webhook.ts"
	],
	"manualContent": [],
	"__mustBeManual": [
		"packages/worker/wrangler.jsonc",
		"packages/worker/migrations/0001.sql",
		"packages/worker/src/billing/x.ts",
		".github/workflows/deploy.yml",
		"patches/foo.patch",
		"packages/shared/src/a.ts"
	],
	"__mustBeAuto": ["packages/worker/src/app/handlers/x.ts", "docs/guides/x.md"]
}
