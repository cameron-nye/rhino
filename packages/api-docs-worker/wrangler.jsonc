{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	// Interactive OpenAPI docs at `api-docs.rhino.nyneelevenlabs.com`
	// (upstream `api-docs.kody.codes`). Serves Scalar HTML and
	// proxies `/openapi.json` from the live API so the UI stays JSON-only on
	// `api.rhino.nyneelevenlabs.com` (no Accept-HTML there). DNS + cert come from
	// `custom_domain: true` on deploy, same as the API host.
	"name": "kody-api-docs",
	"main": "./src/index.ts",
	"compatibility_date": "2026-04-16",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"minify": true,
	"upload_source_maps": true,
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
		},
	},
	"workers_dev": false,
	"routes": [
		{
			"pattern": "api-docs.rhino.nyneelevenlabs.com",
			"custom_domain": true,
		},
	],
	"vars": {
		"OPENAPI_SPEC_URL": "https://api.rhino.nyneelevenlabs.com/openapi.json",
	},
}
