# Secret names emitted as `string` on the generated Env interface.
# Values are placeholders. `wrangler types` records the keys only.
# Do not point this file at a machine-local .env: that makes
# worker-configuration.d.ts depend on whoever last ran generate-types.
COOKIE_SECRET=placeholder
SECRET_STORE_KEY=placeholder
APP_BASE_URL=placeholder
# Production wrangler no longer pins Kent's Fathom site id (WKKSDJGN).
# The tracker stays off unless the FATHOM_SITE_ID Actions variable is set.
# Keep the binding on Env so a later site id still typechecks.
FATHOM_SITE_ID=placeholder
# Production wrangler no longer pins Kent's YouTube playlist, Stripe prices,
# billing portal, or disaster-recovery account. Unset stays off. Keep the
# names on Env so a later Rhino value still typechecks.
YOUTUBE_ALLOWED_PLAYLIST_IDS=placeholder
STRIPE_PRO_PRICE_ID=placeholder
STRIPE_PRO_YEARLY_PRICE_ID=placeholder
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=placeholder
DR_EXPORT_ENABLED=placeholder
DR_D1_PACED_BACKUP_ENABLED=placeholder
DR_D1_PACED_RESTORE_DRILL_ENABLED=placeholder
DR_D1_PACED_SOURCES=placeholder
DR_BACKUP_ACCOUNT_ID=placeholder
DR_BACKUP_BUCKET_NAME=placeholder
BACKUP_MANIFEST_SIGNING_KEY_ID=placeholder
BACKUP_MANIFEST_VERIFYING_PUBLIC_KEY_SPKI_BASE64=placeholder
GITHUB_CLIENT_ID=placeholder
GITHUB_CLIENT_SECRET=placeholder
GOOGLE_CLIENT_ID=placeholder
GOOGLE_CLIENT_SECRET=placeholder
X_CLIENT_ID=placeholder
X_CLIENT_SECRET=placeholder
