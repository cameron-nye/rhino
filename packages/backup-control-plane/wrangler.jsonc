{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "kody-production-d1-backups",
	"main": "./worker.ts",
	"compatibility_date": "2026-07-22",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
		},
	},
	"triggers": {
		"crons": ["15 2 * * *", "45 * * * *"],
	},
	"workflows": [
		{
			"binding": "BACKUP_WORKFLOW",
			"name": "kody-production-d1-backup",
			"class_name": "ProductionD1BackupWorkflow",
		},
		{
			"binding": "RESTORE_WORKFLOW",
			"name": "kody-production-dr-restore",
			"class_name": "ProductionDrRestoreWorkflow",
		},
		{
			"binding": "SEAL_WORKFLOW",
			"name": "kody-production-seal-day",
			"class_name": "ProductionSealDayWorkflow",
		},
	],
	"r2_buckets": [
		{
			"binding": "BACKUP_BUCKET",
			"bucket_name": "kody-production-backups",
		},
	],
	"vars": {
		// Both must be exactly "true" for any schedule to run. Upstream sets
		// both true after the 2026-07-23 benchmark. Rhino leaves them false
		// so cron logs backup-disabled and returns. Worker and bucket names
		// stay. Do not deploy this worker until a Rhino backup account exists.
		"ENABLE_PRODUCTION_D1_BACKUPS": "false",
		"BACKUP_BENCHMARK_APPROVED": "false",
		// Upstream source is Kent's production account
		// a99ee2e72728dd52902ef288b7b1447d and D1
		// 8c1014d1-6b41-4695-a0a2-159071f0f919 (kody) plus
		// 5410331e-4d25-47e4-a1e5-a248f7cc764c (kody-jobs). Blank so a
		// dashboard render cannot call that account. The enable gate throws
		// invalid-source-id before any Cloudflare request.
		"SOURCE_ACCOUNT_ID": "",
		"SOURCE_DATABASE_ID": "",
		"SOURCE_DATABASE_NAME": "",
		"SOURCE_DATABASES": "[]",
		"ALLOWED_SOURCE_ACCOUNT_IDS": "",
		"ALLOWED_SOURCE_DATABASE_IDS": "",
		"BUILD_COMMIT": "REPLACE_AT_DEPLOY_TIME",
		// Upstream key id is kody-dr-2026-07 with Kent's Ed25519 public key.
		// Blank so this fork does not trust that signer.
		"BACKUP_MANIFEST_SIGNING_KEY_ID": "",
		"BACKUP_MANIFEST_VERIFYING_PUBLIC_KEY_SPKI_BASE64": "",
		// SHA-256 of the JSON array of sorted migration filenames at the
		// deployment commit; recompute when adding a migration (recipe in
		// docs/contributing/disaster-recovery.md).
		"TRUSTED_RESTORE_BASELINE_ID": "kody-migration-set-2026-07",
		"TRUSTED_RESTORE_BASELINE_SHA256": "63d10bfc5a672b33a610287ebd3ee5036ee5e719ee8271c1a32f4a44a524a2d7",
		"BACKUP_MAX_AGE_HOURS": "26",
		// D1 GET file_size must remain strictly below this single-object ceiling.
		"BACKUP_MAX_SOURCE_BYTES": "4500000000",
		// Upstream Access team is kentcdodds.cloudflareaccess.com, aud
		// 769c70e393e2652f5878af99333322184a35cc3aef53376344f8753805e42a76,
		// and ACCESS_ALLOWED_EMAIL me@kentcdodds.com. Blank.
		"ACCESS_TEAM_DOMAIN": "",
		"ACCESS_APP_AUD": "",
		"ACCESS_ALLOWED_EMAIL": "",
		// Upstream DRILL_ACCOUNT_ID is the KCD account
		// a41d50ecaf0ae0f86dd1824ef6729cb2. Blank. Drills stay off.
		"DRILL_ACCOUNT_ID": "",
		// Upstream origin is https://kody.codes. Blank so a restore cannot
		// POST there.
		"PRIMARY_WORKER_ORIGIN": "",
	},
}
