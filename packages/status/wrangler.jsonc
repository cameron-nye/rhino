{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "kody-status",
	"main": "./worker.ts",
	"compatibility_date": "2026-07-22",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
		},
	},
	// One probe pass per minute; incidents open after three consecutive failures.
	"triggers": {
		"crons": ["* * * * *"],
	},
	// Deliberately independent from the main worker: the status page must stay
	// up when main-app deploys break or the app D1 database is down, so it
	// has its own domain and its own Durable Object storage.
	"routes": [
		{
			// Upstream: status.kody.codes. Workers custom domains issue their
			// own certificate, including this nested name on a Free zone.
			"pattern": "status.rhino.nyneelevenlabs.com",
			"custom_domain": true,
		},
	],
	"services": [
		{
			// Worker-to-worker only. Not a public jobs hostname.
			"binding": "JOBS",
			"service": "kody-jobs",
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "STATUS_STORE",
				"class_name": "StatusStore",
			},
		],
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["StatusStore"],
		},
	],
	// Named favicon PNGs. `/` has no index.html, so the worker still
	// renders the page. `/favicon.ico` is worker-handled and 302s to the
	// current overall-status file.
	"assets": {
		"directory": "./public",
		"html_handling": "none",
		"not_found_handling": "none",
	},
	"vars": {
		"PRIMARY_ORIGIN": "https://rhino.nyneelevenlabs.com",
		// Apex of the package-app zone. Upstream is https://kody.run. The
		// prober requests /__runtime/health here. A blank origin stays
		// operational and does not open an incident.
		"PACKAGE_APP_ORIGIN": "https://nyneelevenlabs.dev",
		"STATUS_PAGE_URL": "https://status.rhino.nyneelevenlabs.com",
		// Upstream alert recipient is me@kentcdodds.com.
		"ALERT_EMAIL_TO": "csnye86@gmail.com",
		"ALERT_EMAIL_FROM": "kody@rhino.nyneelevenlabs.com",
		"STATUS_ALERT_DAILY_LIMIT": "6",
		// Upstream account a99ee2e72728dd52902ef288b7b1447d. This is the
		// Rhino account the Email Sending token must belong to.
		"CLOUDFLARE_ACCOUNT_ID": "fc56d8089384bf6a7806ff0e9a9385a0",
		"BUILD_COMMIT": "REPLACE_AT_DEPLOY_TIME",
	},
}
